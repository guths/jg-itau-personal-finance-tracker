# Copie para .env (que fica fora do git) e preencha.
MYSQL_DSN=finance:finance@tcp(127.0.0.1:3307)/finance?parseTime=true&loc=UTC
MYSQL_TEST_DSN=finance:finance@tcp(127.0.0.1:3307)/finance_test?parseTime=true&loc=UTC
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Senha dos PDFs de fatura do Itaú
ITAU_PDF_PASSWORD=
HTTP_ADDR=127.0.0.1:8080
# Caminhos relativos são resolvidos a partir da pasta deste arquivo
DATA_DIR=data
SAMPLES_DIR=samples

# Backup (restic). A senha criptografa o backup: guarde-a num gerenciador de senhas — sem ela
# não há restauração. Escolha UM provedor:
RESTIC_PASSWORD=
# Backblaze B2 (bucket privado; chave de aplicação restrita ao bucket):
RESTIC_REPOSITORY=b2:NOME-DO-BUCKET:jg-finance
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Cloudflare R2 (API token S3 com permissão no bucket) — descomente e apague as linhas do B2:
# RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/NOME-DO-BUCKET/jg-finance
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
